# عنوان الـ API الخلفي (يُترك فارغاً حالياً لاستخدام البيانات التجريبية داخل التطبيق)
# مثال: https://api.wasel.ly
EXPO_PUBLIC_API_URL=

# مهلة الانتظار لطلبات الشبكة بالمللي ثانية
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# تفعيل محاكاة تقدّم الطلبات تلقائياً (true/false) — مفيد للعرض بدون باك إند
EXPO_PUBLIC_SIMULATE_ORDERS=true
